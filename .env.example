# Public token configuration
SURVIVE_TOKEN_CA=
# Optional immutable token birth time, as a 13-digit Unix timestamp in milliseconds.
# Example: SURVIVE_BIRTH_TIMESTAMP=1788191234000
SURVIVE_BIRTH_TIMESTAMP=

# Server-only provider credentials. Never commit a populated .env file.
HELIUS_API_KEY=
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_RPC_API_KEY
SOLANA_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
BIRDEYE_API_KEY=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
