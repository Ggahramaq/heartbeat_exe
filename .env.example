# Public token configuration. HEARTBEAT_TOKEN_CA is canonical.
HEARTBEAT_TOKEN_CA=
# Legacy migration fallback. Existing Vercel deployments may keep this until
# HEARTBEAT_TOKEN_CA has been added and verified.
SURVIVE_TOKEN_CA=

# Server-only provider credentials. Never commit a populated .env file.
HELIUS_API_KEY=
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_RPC_API_KEY
SOLANA_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
BIRDEYE_API_KEY=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
